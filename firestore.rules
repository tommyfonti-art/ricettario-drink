// Regole del database del ricettario (Firebase → Firestore Database → Regole).
// Si incollano a mano nella console e si preme «Pubblica»: dal codice non si possono cambiare.
// Entrano SOLO gli utenti scritti qui sotto, creati da Tommi nella console di Firebase.
// Un account creato da chiunque altro non legge e non scrive niente.
// - Tommi e Claude leggono e scrivono tutto.
// - Ospiti (i colleghi) leggono tutto, ma scrivono SOLO le voci della lista «cose da fare».
// Per far entrare una persona nuova: crearla in Authentication → Users e aggiungere qui il suo UID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function boss() {
      return request.auth != null && request.auth.uid in [
        'kPhxvAxY5hOF3D5DKATM2RKiBDt1',
        'hbbjBMkdJ4ZQ9hNfSBibsP2x8ph1'
      ];
    }
    function ammesso() {
      return boss() || (request.auth != null && request.auth.uid in [
        'y9i2vGDPpDZz1ymdcVxFwqWK5yt2'  // ospiti (colleghi)
      ]);
    }
    match /dati/{id} {
      allow read: if ammesso();
      allow write: if boss();
      allow create, update: if ammesso()
        && id.matches('cose~.*')
        && request.resource.data.c == 'cose'
        && request.resource.data.i is string
        && request.resource.data.j is string
        && request.resource.data.j.size() < 2000;
      allow delete: if ammesso() && id.matches('cose~.*');
    }
    match /cronologia/{id} {
      allow read, write: if boss();
    }
    match /foto/{id} {
      allow read: if ammesso();
      allow write: if boss();
    }
  }
}
